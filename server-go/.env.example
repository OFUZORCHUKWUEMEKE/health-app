# Go service env. Mirrors health-app/.env.example keys used by the skeleton.
PORT=4000
APP_ENV=development
CORS_ORIGINS=
ALLOW_ADMIN_BOOTSTRAP=false

# Postgres (pgx pool). Empty = run without a database (/readyz 503).
DATABASE_URL=postgres://postgres@localhost:5433/telemex?sslmode=disable
# Integration tests use this database (create it, then run migrations).
TEST_DATABASE_URL=postgres://postgres@localhost:5433/telemex_test?sslmode=disable
# Connection ceiling (fan-out width stays at or below this).
DB_MAX_CONNS=25
# Slow-query log threshold in ms (0 disables); bound args never logged (PHI).
SLOW_QUERY_MS=500

# Auth (M6). Secrets are required at boot; expirations accept 15m/24h/7d/90d.
JWT_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_EXPIRATION=7d
JWT_REFRESH_EXPIRATION=90d
REGISTRATION_TOKEN_SECRET=
PASSWORD_RESET_TOKEN_SECRET=
REGISTRATION_TOKEN_EXPIRATION=15m
PASSWORD_RESET_TOKEN_EXPIRATION=15m

# Auth module (M7). Frontend URL feeds OAuth/reset redirects; empty mail host
# logs instead of sending; bootstrap stays disabled unless explicitly opened.
FRONTEND_URL=http://localhost:3000
EMAIL_HOST=
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
ADMIN_BOOTSTRAP_KEY=
RETURN_OTP_IN_RESPONSE=

# Booking (M12). manual requires doctor_id (PENDING); auto matches (CONFIRMED).
BOOKING_MODE=auto

# Reminder sweep (M15). Empty = dispatch endpoint disabled (403).
REMINDER_DISPATCH_KEY=

# Video (M16). Empty = token endpoints return controlled 503.
DAILY_API_KEY=

# File uploads (M9/M17). Empty cloud name disables uploads (controlled 503).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PROFILE_FOLDER=health-app/profile-pictures
CLOUDINARY_INVESTIGATION_FOLDER=health-app/investigation-results
